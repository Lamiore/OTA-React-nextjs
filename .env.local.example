NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_DATABASE_URL=https://ota-db-default-rtdb.firebaseio.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# URL server Python kamera (Flask app_web.py), contoh: http://192.168.1.10:5001
NEXT_PUBLIC_CAMERA_URL=

# --- Email verifikasi via SMTP sendiri ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
# base64 -i ota-db-firebase-adminsdk-*.json | tr -d '\n'
FIREBASE_ADMIN_SA_B64=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Lautara <no-reply@example.com>"

# --- Asisten chat (Gemini) ---
# Ambil di https://aistudio.google.com/apikey — gratis, tanpa kartu kredit.
# Server-only: JANGAN diberi prefix NEXT_PUBLIC_, nanti kebawa ke browser.
GEMINI_API_KEY=
# Opsional. Default gemini-3.5-flash-lite (termurah, masuk kuota gratis).
GEMINI_MODEL=
