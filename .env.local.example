NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_DATABASE_URL=https://ota-db-default-rtdb.firebaseio.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Tidak terpakai lagi — alamat server kamera dibaca dari dokumen Firestore
# settings/cameraServer, diatur lewat Dashboard › Kamera. Dibiarkan supaya
# .env.local lama tidak bingung; aman dikosongkan.
NEXT_PUBLIC_CAMERA_URL=

# --- Email verifikasi via SMTP sendiri ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
# base64 -i ota-db-firebase-adminsdk-*.json | tr -d '\n'
FIREBASE_ADMIN_SA_B64=
# Alternatif FIREBASE_ADMIN_SA_B64: path ke berkas service account JSON.
# Dipakai lib/firebaseAdmin.ts sebagai cadangan, dan oleh skrip di scripts/.
GOOGLE_APPLICATION_CREDENTIALS=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Nusa <no-reply@example.com>"

# --- Asisten chat (Gemini) ---
# Ambil di https://aistudio.google.com/apikey — gratis, tanpa kartu kredit.
# Server-only: JANGAN diberi prefix NEXT_PUBLIC_, nanti kebawa ke browser.
GEMINI_API_KEY=
# Opsional. Default gemini-3.5-flash-lite (termurah, masuk kuota gratis).
GEMINI_MODEL=

# --- Pembayaran (Midtrans Snap) ---
# Ambil di dashboard Midtrans › Settings › Access Keys.
# Biarkan MIDTRANS_IS_PRODUCTION kosong/false untuk memakai Sandbox.
MIDTRANS_SERVER_KEY=
NEXT_PUBLIC_MIDTRANS_CLIENT_KEY=
MIDTRANS_IS_PRODUCTION=false
# URL publik yang bisa dijangkau webhook Midtrans. Saat mengembangkan di lokal,
# isi dengan alamat terowongan (lihat bagian "Menguji webhook dari mesin lokal").
MIDTRANS_NOTIFICATION_URL=
