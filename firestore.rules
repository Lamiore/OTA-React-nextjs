rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Kode login 6 digit. Ditulis dan dibaca hanya oleh Admin SDK di
    // /api/auth/* (Admin SDK melewati rules). Ditutup rapat dari klien:
    // isinya hash kode yang sedang berlaku — satu-satunya kunci masuk akun
    // sekarang password sudah tidak ada.
    match /loginCodes/{codeId} {
      allow read, write: if false;
    }

    match /users/{userId} {
      // Baca: pemilik dokumen sendiri, atau admin.
      allow read: if request.auth != null
        && (
          request.auth.uid == userId
          || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'
        );

      // Buat dokumen sendiri saat pertama daftar — role wajib 'user'.
      allow create: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.role == 'user';

      // Update: admin bebas (termasuk ubah role, wilayah pengelola, approve/tolak pengajuan pengelola);
      // pemilik boleh update dokumennya sendiri HANYA jika role tidak berubah.
      //
      // `verification` dikecualikan dari kebebasan itu. Tanpa syarat di bawah,
      // gerbang "pendaftaran pengelola dibuka admin" cuma hidup di antarmuka:
      // siapa pun yang sudah login bisa menulis verification.status 'pending'
      // sendiri lewat SDK dari console browser, dan kartu pengajuannya tetap
      // muncul di panel Pengguna — antrean tinjauan admin bisa dibanjiri tanpa
      // satu tombol pun ditekan. Yang diizinkan hanya SATU perpindahan:
      // 'invited' (tiketnya dibukakan admin) menjadi 'pending' (formulirnya
      // dikirim). Membuka tiket sendiri, meluluskan diri sendiri, dan menyunting
      // jejak persetujuan sesudah terkirim sama-sama ditolak server.
      //
      // Yang dijaga di sini KAPAN boleh menulis, bukan APA yang ditulis: isi
      // formulirnya (nama, instansi, versi perjanjian) tetap datang dari klien
      // dan dipercaya apa adanya. Kalau isinya juga mau dijamin, pengirimannya
      // harus pindah ke route server yang memakai Admin SDK.
      allow update: if request.auth != null
        && (
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'
          || (
            request.auth.uid == userId
            && request.resource.data.role == resource.data.role
            && (
              // Update biasa — nama, no. HP, wishlist. Tidak menyentuh verification.
              !request.resource.data.diff(resource.data).affectedKeys().hasAny(['verification'])
              // Atau: kirim formulir dari tiket yang memang dibukakan admin.
              // .get() dengan jalur list dipakai, bukan akses langsung: dokumen
              // pengguna yang belum pernah punya pengajuan tidak punya field
              // `verification` sama sekali, dan akses langsung ke situ error
              // (yang berarti tolak) — di sini defaultnya memang harus tolak,
              // tapi lewat perbandingan yang jelas, bukan lewat error.
              || (
                resource.data.get(['verification', 'status'], '') == 'invited'
                && request.resource.data.verification.status == 'pending'
              )
            )
          )
        );
    }

    match /destinations/{docId} {
      function destUserRole() {
        return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
      }
      allow read: if true;

      /** Dokumen destinasi yang diklaim sebagai induk oleh dokumen yang mau dibuat. */
      function claimedParent() {
        return get(/databases/$(database)/documents/destinations/$(request.resource.data.parentId)).data;
      }

      // Destinasi tingkat atas tetap milik admin: yang itu muncul di beranda dan
      // membawa nama, wilayah, stasiun sensor, serta kameranya. Dokumen destinasi
      // pengelola dibuat otomatis oleh approveRoleRequest — yang jalan sebagai
      // admin saat menyetujui pengajuan, jadi tetap lewat cabang pertama.
      //
      // Cabang kedua membuka satu hal saja: pengelola menambah destinasi DI DALAM
      // destinasi yang sudah jadi miliknya (tiap pulau/spot di bawah satu
      // provinsi). Tiga syaratnya saling menopang dan tidak boleh dilepas satu
      // pun:
      //
      // - managerUid == uid pemanggil, supaya spot baru tidak bisa dititipkan
      //   atas nama pengelola lain;
      // - induknya dibaca dari server dan managerUid-nya harus si pemanggil juga
      //   — tanpa ini pengelola mana pun bisa menyisipkan spot ke dalam destinasi
      //   orang lain, dan spot itu tayang di halaman publik destinasi tersebut;
      // - hasOnly() mengunci daftar kolomnya. Ini yang menahan eskalasi: tanpa
      //   dia, dokumen baru boleh membawa `stationId` atau `cameraIds` milik
      //   perangkat orang lain, dan halaman spot itu jadi menayangkan siaran
      //   yang bukan haknya. Daftar ini harus sama persis dengan yang ditulis
      //   addChildDestination() di lib/firestore.ts.
      //
      // Kedalamannya sengaja tidak dibatasi. Bagi pengelola lingkaran induk–anak
      // memang tidak mungkin terbentuk: parentId tidak ada di daftar kolom yang
      // boleh di-update, jadi induk sebuah dokumen tidak bisa dipindah setelah
      // dibuat. Admin bisa memindahkannya (cabang pertama tidak dibatasi kolom),
      // jadi bagi admin yang menahan lingkaran itu antarmuka, bukan rules:
      // parentOptions() di lib/destination membuang diri sendiri berikut seluruh
      // isinya dari pilihan induk di panel admin.
      allow create: if request.auth != null
        && (
          destUserRole() == 'admin'
          || (
            destUserRole() == 'pengelola'
            && request.resource.data.managerUid == request.auth.uid
            && request.resource.data.parentId is string
            && request.resource.data.parentId != ''
            && claimedParent().managerUid == request.auth.uid
            // hasOnly() melarang kolom asing, tapi tidak mewajibkan satu pun ada.
            // Nama dijaga di sini, bukan cukup di panel: kartu & judul halaman
            // memanggil name.trim(), jadi satu dokumen tanpa nama yang ditulis
            // lewat SDK mentah membuat halaman kawasan induknya melempar error
            // untuk semua pengunjung, bukan cuma bagi yang menulisnya.
            && request.resource.data.name is string
            && request.resource.data.name != ''
            && request.resource.data.keys().hasOnly([
                 'name', 'location', 'thumbColor', 'parentId', 'managerUid', 'emoji',
                 'tags', 'description', 'image', 'images', 'lat', 'lng', 'whatsapp',
                 'priceItems', 'createdAt'
               ])
          )
        );

      // Hapus: admin bebas. Pengelola hanya boleh menghapus spot di DALAM
      // destinasinya — `parentId` yang wajib terisi itulah yang menahan dia
      // menghapus destinasi kelolaannya sendiri, satu-satunya jalan pulih dari
      // itu adalah admin membuatkannya lagi dari nol.
      allow delete: if request.auth != null
        && (
          destUserRole() == 'admin'
          || (
            destUserRole() == 'pengelola'
            && resource.data.managerUid == request.auth.uid
            && resource.data.get('parentId', '') != ''
          )
        );

      // Pengelola hanya boleh menyunting destinasi kelolaannya sendiri, dan
      // hanya kolom yang dijanjikan Pasal 3 Perjanjian Pengelola. hasOnly()
      // wajib ada, bukan cuma cek managerUid: tanpa itu pengelola bisa
      // mengalihkan destinasinya ke orang lain dengan menulis ulang managerUid,
      // atau menyerobot stationId/cameraId milik perangkat lain.
      // Daftar ini harus sama persis dengan EDITABLE_KEYS di
      // components/dashboard/PengelolaDestinasiPanel.tsx.
      allow update: if request.auth != null
        && (
          destUserRole() == 'admin'
          || (
            destUserRole() == 'pengelola'
            && resource.data.managerUid == request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['description', 'image', 'images', 'lat', 'lng', 'priceItems', 'whatsapp'])
          )
        );
    }

    match /monitoring_data/{docId} {
      allow read: if true;
    }

    match /bookings/{bookingId} {
      // Ditulis HANYA oleh Admin SDK lewat /api/bookings (Admin SDK melewati
      // rules), sama seperti loginCodes di atas. Menutupnya di sini bukan
      // pengetatan kosmetik — inilah yang membuat tiga jaminan berikut ada:
      //
      // 1. Harga. Dulu klien mengirim `amount` sendiri; siapa pun bisa
      //    membuat booking Rp 0 lewat SDK dari console browser. Sekarang
      //    server yang membaca daftar harga destinasi dan menghitung ulang.
      // 2. Sekali masuk per tiket. Dulu pemilik booking boleh meng-update
      //    dokumennya sendiri, termasuk menulis balik status 'used' menjadi
      //    'confirmed' — transaksi anti-double-check-in di ScanPanel jadi
      //    percuma karena bisa dilangkahi satu updateDoc.
      // 3. Pembayaran. Dulu paymentStatus 'paid' tinggal ditulis sendiri
      //    tanpa membayar apa pun.
      allow create, update, delete: if false;

      // Baca: booking sendiri, atau petugas (admin/pengelola).
      //
      // Sebelumnya cukup `request.auth != null` — aplikasinya memang selalu
      // memfilter `userId == uid`, tapi rules-nya membiarkan siapa pun yang
      // sudah login membaca SELURUH koleksi lewat SDK: nama dan nomor HP
      // semua pemesan.
      //
      // Urutan disengaja, sama seperti blok cameras: cek pertama hanya
      // membaca dokumen booking itu sendiri (gratis). get() ke users/{uid}
      // berbayar, jadi ia ditaruh belakangan agar pengguna biasa — yang
      // selalu lolos lewat cek pertama — tidak ikut membayarinya.
      //
      // Kueri berfilter `where('userId','==',uid)` (BookingHistory,
      // NotificationBell) lolos lewat cabang pertama; dasbor yang membaca
      // seluruh koleksi (StatistikPanel, PengelolaStatistikPanel, ScanPanel)
      // lolos lewat cabang peran.
      allow read: if request.auth != null
        && (
          resource.data.userId == request.auth.uid
          || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['admin', 'pengelola']
        );
    }

    match /cameras/{cameraId} {
      function camUserRole() {
        return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
      }
      // Baca: kamera yang dipublikkan pemiliknya, pemilik sendiri, admin, atau
      // email yang dimasukkan pemilik ke `viewers`.
      //
      // isPublic dicek paling depan: cabangnya cuma membaca dokumen kamera itu
      // sendiri (gratis) dan kamera publik adalah kasus yang paling sering
      // lolos. `request.auth != null` tetap berlaku untuknya — "publik" di sini
      // berarti semua pengguna yang sudah masuk, sejalan dengan rule
      // settings/cameraServer yang juga menuntut akun.
      //
      // Urutan sengaja: dua cek pertama cuma baca dokumen kamera itu sendiri
      // (gratis). camUserRole() ditaruh paling akhir karena isinya get() ke
      // users/{uid} milik si pembaca — get() itu berbayar, dan kalau ditaruh
      // di depan, setiap penonton allowlist (bukan admin) bayar get() itu dulu
      // padahal dia lolos lewat cek viewers, bukan cek admin.
      //
      // Cabang "pengelola untuk kamera di wilayahnya" sengaja tidak ada.
      // Bukan cuma karena pengelola sekarang memiliki kameranya sendiri: cabang
      // itu bergantung pada isi dokumen (`resource.data.location`), dan rules
      // bukan filter — query koleksi tanpa constraint tidak bisa dipenuhi
      // olehnya, sehingga panel Kamera pengelola ditolak seluruhnya. Klien
      // memakai query `where('ownerUid','==',uid)` yang membuktikan cabang
      // pertama di muka.
      //
      // get('viewers', []) dipakai, bukan resource.data.viewers: dokumen kamera
      // lama tidak punya field itu dan akses langsung jadi error, bukan false.
      allow read: if request.auth != null
        && (
          resource.data.get('isPublic', false) == true
          || resource.data.ownerUid == request.auth.uid
          || request.auth.token.email in resource.data.get('viewers', [])
          || camUserRole() == 'admin'
        );
      // Pendaftaran kamera sekarang milik admin saja, dan pemiliknya boleh orang
      // lain: admin memilih destinasinya di form, lalu kameranya didaftarkan atas
      // nama uid pengelola destinasi itu supaya muncul di Monitoring miliknya
      // (panel itu query `where('ownerUid','==',uid)` — rules bukan filter, jadi
      // kamera atas nama admin tidak akan pernah ikut terbawa ke sana).
      //
      // Status wajib 'pending': approve/reject eksklusif milik server VPS (Admin
      // SDK, bypass rules), jadi tidak ada yang bisa menyetujui kameranya sendiri.
      //
      // ownerUid wajib string tak kosong. Tanpa itu, sekali saja klien salah
      // mengirim '' (mis. destinasi tanpa pengelola), kameranya jadi milik
      // siapa-siapa: tidak muncul di panel mana pun dan tidak bisa dihapus
      // pemiliknya, karena tidak ada uid yang cocok.
      allow create: if request.auth != null
        && request.resource.data.status == 'pending'
        && request.resource.data.ownerUid is string
        && request.resource.data.ownerUid != ''
        && camUserRole() == 'admin';
      allow delete: if request.auth != null
        && (resource.data.ownerUid == request.auth.uid || camUserRole() == 'admin');
      // Pemilik mengelola daftar penontonnya dan tombol publik/khusus, dan HANYA
      // itu. hasOnly() wajib: tanpanya pemilik bisa menyetujui kameranya sendiri
      // lewat jalur ini, padahal approve/reject eksklusif milik server VPS.
      //
      // Cek tipenya wajib juga: tanpa `viewers is list`, SDK mentah bisa menulis
      // viewers bukan-list (mis. string), lalu `email in viewers` di rule baca
      // error dan kamera itu terkunci dari semua pembaca sampai field-nya
      // dibetulkan lagi. isPublic sama — bukan-bool membuat cabang pertama rule
      // baca membandingkan tipe yang salah.
      //
      // get(...) dengan default, bukan akses langsung: menyalakan tombol publik
      // pada kamera lama yang belum punya field `viewers` tidak boleh ditolak
      // hanya karena field yang tidak disentuh itu memang tidak ada.
      allow update: if request.auth != null
        && resource.data.ownerUid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['viewers', 'isPublic'])
        && request.resource.data.get('viewers', []) is list
        && request.resource.data.get('isPublic', false) is bool;
    }

    match /reviews/{reviewId} {
      // Ulasan destinasi: dibaca publik (rata-rata & daftar tampil di halaman destinasi).
      allow read: if true;
      // Tulis/ubah hanya oleh pemilik; id dokumen wajib `<destinationId>_<uid>`
      // (mengunci 1 ulasan per user per destinasi); rating wajib bilangan 1..5.
      allow create, update: if request.auth != null
        && request.resource.data.userId == request.auth.uid
        && reviewId == request.resource.data.destinationId + '_' + request.auth.uid
        && request.resource.data.rating is int
        && request.resource.data.rating >= 1
        && request.resource.data.rating <= 5;
      allow delete: if request.auth != null
        && resource.data.userId == request.auth.uid;
    }

    match /settings/{settingId} {
      function settingsUserRole() {
        return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
      }
      // Alamat server kamera dulu publik: halaman destinasi publik menyusun URL
      // stream dari sini, termasuk untuk pengunjung anonim. Sekarang dokumen
      // kamera sendiri sudah digerbangi rules (match /cameras/{cameraId}) dan id
      // stream-nya tidak lagi didenormalisasi ke dokumen destinasi publik, jadi
      // pengunjung anonim tidak pernah punya cameraId untuk disusun jadi URL.
      // Alamat server hanya berguna bagi pembaca yang sudah bisa membaca
      // dokumen kameranya — dan itu selalu pengguna yang sudah masuk.
      allow read: if request.auth != null;
      // Hanya pengelola kamera yang boleh mengubah alamat server.
      allow write: if request.auth != null
        && settingsUserRole() in ['pengelola', 'admin'];
    }

  }
}
