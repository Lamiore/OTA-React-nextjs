rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Kode login 6 digit. Ditulis dan dibaca hanya oleh Admin SDK di
    // /api/auth/* (Admin SDK melewati rules). Ditutup rapat dari klien:
    // isinya hash kode yang sedang berlaku — satu-satunya kunci masuk akun
    // sekarang password sudah tidak ada.
    match /loginCodes/{codeId} {
      allow read, write: if false;
    }

    match /users/{userId} {
      // Baca: pemilik dokumen sendiri, atau admin.
      allow read: if request.auth != null
        && (
          request.auth.uid == userId
          || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'
        );

      // Buat dokumen sendiri saat pertama daftar — role wajib 'user'.
      allow create: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.role == 'user';

      // Update: admin bebas (termasuk ubah role, wilayah pengelola, approve/tolak pengajuan pengelola);
      // pemilik boleh update dokumennya sendiri HANYA jika role tidak berubah.
      allow update: if request.auth != null
        && (
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'
          || (
            request.auth.uid == userId
            && request.resource.data.role == resource.data.role
          )
        );
    }

    match /destinations/{docId} {
      function destUserRole() {
        return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
      }
      allow read: if true;

      // Membuat & menghapus destinasi tetap admin. Dokumen destinasi pengelola
      // dibuat otomatis oleh approveRoleRequest — yang jalan sebagai admin saat
      // menyetujui pengajuan, jadi tetap lewat cabang ini.
      allow create, delete: if request.auth != null && destUserRole() == 'admin';

      // Pengelola hanya boleh menyunting destinasi kelolaannya sendiri, dan
      // hanya kolom yang dijanjikan Pasal 3 Perjanjian Pengelola. hasOnly()
      // wajib ada, bukan cuma cek managerUid: tanpa itu pengelola bisa
      // mengalihkan destinasinya ke orang lain dengan menulis ulang managerUid,
      // atau menyerobot stationId/cameraId milik perangkat lain.
      // Daftar ini harus sama persis dengan EDITABLE_KEYS di
      // components/dashboard/PengelolaDestinasiPanel.tsx.
      allow update: if request.auth != null
        && (
          destUserRole() == 'admin'
          || (
            destUserRole() == 'pengelola'
            && resource.data.managerUid == request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['description', 'image', 'images', 'lat', 'lng', 'priceItems', 'whatsapp'])
          )
        );
    }

    match /monitoring_data/{docId} {
      allow read: if true;
    }

    match /bookings/{bookingId} {
      allow create: if request.auth != null;
      allow read:   if request.auth != null;
      allow update: if request.auth != null
        && (
          resource.data.userId == request.auth.uid
          || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['admin', 'pengelola']
        );
    }

    match /cameras/{cameraId} {
      function camUserRole() {
        return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
      }
      // Baca: pemilik, admin, atau email yang dimasukkan pemilik ke `viewers`.
      //
      // Urutan sengaja: dua cek pertama cuma baca dokumen kamera itu sendiri
      // (gratis). camUserRole() ditaruh paling akhir karena isinya get() ke
      // users/{uid} milik si pembaca — get() itu berbayar, dan kalau ditaruh
      // di depan, setiap penonton allowlist (bukan admin) bayar get() itu dulu
      // padahal dia lolos lewat cek viewers, bukan cek admin.
      //
      // Cabang "pengelola untuk kamera di wilayahnya" sengaja tidak ada.
      // Bukan cuma karena pengelola sekarang memiliki kameranya sendiri: cabang
      // itu bergantung pada isi dokumen (`resource.data.location`), dan rules
      // bukan filter — query koleksi tanpa constraint tidak bisa dipenuhi
      // olehnya, sehingga panel Kamera pengelola ditolak seluruhnya. Klien
      // memakai query `where('ownerUid','==',uid)` yang membuktikan cabang
      // pertama di muka.
      //
      // get('viewers', []) dipakai, bukan resource.data.viewers: dokumen kamera
      // lama tidak punya field itu dan akses langsung jadi error, bukan false.
      allow read: if request.auth != null
        && (
          resource.data.ownerUid == request.auth.uid
          || request.auth.token.email in resource.data.get('viewers', [])
          || camUserRole() == 'admin'
        );
      // Pendaftaran kamera sekarang milik admin saja, dan pemiliknya boleh orang
      // lain: admin memilih destinasinya di form, lalu kameranya didaftarkan atas
      // nama uid pengelola destinasi itu supaya muncul di Monitoring miliknya
      // (panel itu query `where('ownerUid','==',uid)` — rules bukan filter, jadi
      // kamera atas nama admin tidak akan pernah ikut terbawa ke sana).
      //
      // Status wajib 'pending': approve/reject eksklusif milik server VPS (Admin
      // SDK, bypass rules), jadi tidak ada yang bisa menyetujui kameranya sendiri.
      //
      // ownerUid wajib string tak kosong. Tanpa itu, sekali saja klien salah
      // mengirim '' (mis. destinasi tanpa pengelola), kameranya jadi milik
      // siapa-siapa: tidak muncul di panel mana pun dan tidak bisa dihapus
      // pemiliknya, karena tidak ada uid yang cocok.
      allow create: if request.auth != null
        && request.resource.data.status == 'pending'
        && request.resource.data.ownerUid is string
        && request.resource.data.ownerUid != ''
        && camUserRole() == 'admin';
      allow delete: if request.auth != null
        && (resource.data.ownerUid == request.auth.uid || camUserRole() == 'admin');
      // Pemilik mengelola daftar penontonnya, dan HANYA itu. hasOnly() wajib:
      // tanpanya pemilik bisa menyetujui kameranya sendiri lewat jalur ini,
      // padahal approve/reject eksklusif milik server VPS.
      // `viewers is list` wajib juga: tanpanya SDK mentah bisa menulis viewers
      // bukan-list (mis. string), lalu `email in viewers` di rule baca error dan
      // kamera itu terkunci dari semua pembaca sampai field-nya dibetulkan lagi.
      allow update: if request.auth != null
        && resource.data.ownerUid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['viewers'])
        && request.resource.data.viewers is list;
    }

    match /reviews/{reviewId} {
      // Ulasan destinasi: dibaca publik (rata-rata & daftar tampil di halaman destinasi).
      allow read: if true;
      // Tulis/ubah hanya oleh pemilik; id dokumen wajib `<destinationId>_<uid>`
      // (mengunci 1 ulasan per user per destinasi); rating wajib bilangan 1..5.
      allow create, update: if request.auth != null
        && request.resource.data.userId == request.auth.uid
        && reviewId == request.resource.data.destinationId + '_' + request.auth.uid
        && request.resource.data.rating is int
        && request.resource.data.rating >= 1
        && request.resource.data.rating <= 5;
      allow delete: if request.auth != null
        && resource.data.userId == request.auth.uid;
    }

    match /settings/{settingId} {
      function settingsUserRole() {
        return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
      }
      // Alamat server kamera dulu publik: halaman destinasi publik menyusun URL
      // stream dari sini, termasuk untuk pengunjung anonim. Sekarang dokumen
      // kamera sendiri sudah digerbangi rules (match /cameras/{cameraId}) dan id
      // stream-nya tidak lagi didenormalisasi ke dokumen destinasi publik, jadi
      // pengunjung anonim tidak pernah punya cameraId untuk disusun jadi URL.
      // Alamat server hanya berguna bagi pembaca yang sudah bisa membaca
      // dokumen kameranya — dan itu selalu pengguna yang sudah masuk.
      allow read: if request.auth != null;
      // Hanya pengelola kamera yang boleh mengubah alamat server.
      allow write: if request.auth != null
        && settingsUserRole() in ['pengelola', 'admin'];
    }

  }
}
